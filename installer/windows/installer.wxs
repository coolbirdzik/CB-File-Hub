<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?define ProductName = "CB File Hub"?>
  <?ifndef ProductVersion?>
  <?define ProductVersion = "1.0.0"?>
  <?endif?>
  <?ifndef ProductDisplayVersion?>
  <?define ProductDisplayVersion = "$(var.ProductVersion)"?>
  <?endif?>
  <?define Manufacturer = "COOLBIRDZIK"?>
  <?define UpgradeCode = "683b4433-9621-4c1f-9a64-4f980bb8465d"?>
  <?define AssetsDir = "$(sys.SOURCEFILEDIR)assets"?>

  <Package Name="$(var.ProductName) v$(var.ProductDisplayVersion)" Language="1033" Version="$(var.ProductVersion)"
    Manufacturer="$(var.Manufacturer)" UpgradeCode="$(var.UpgradeCode)" InstallerVersion="200"
    Scope="perMachine">

    <SummaryInformation Description="$(var.ProductName) Installer" />
    <Property Id="ARPCOMMENTS" Value="Full version: $(var.ProductDisplayVersion)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="CB File Hub" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="TorrentAssociations" />
    </Feature>

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\LicenseAgreement.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\dialog.bmp" />

    <!-- Icon: the same file the app exe embeds (scripts/generate_app_icons.py) -->
    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\..\cb_file_manager\windows\runner\resources\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CB File Hub">
        <Directory Id="DataFolder" Name="data" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CB File Hub" />
    </StandardDirectory>

    <!-- Desktop -->
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <!-- ProductComponents is generated at build time from the Windows Release bundle. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="TorrentAssociations" Guid="*">
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.File.torrent" Type="string" Value="CB File Hub Torrent" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.File.torrent\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]cb_file_hub.exe&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.File.torrent\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]cb_file_hub.exe&quot; --open-torrent &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.torrent\OpenWithProgids" Name="CBFileHub.File.torrent" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.Magnet" Type="string" Value="CB File Hub Magnet Link" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.Magnet" Name="URL Protocol" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.Magnet\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]cb_file_hub.exe&quot;,0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CBFileHub.Magnet\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]cb_file_hub.exe&quot; --open-torrent &quot;%1&quot;" />
        <RegistryValue Root="HKLM" Key="Software\COOLBIRDZIK\CB File Hub\Capabilities" Name="ApplicationName" Type="string" Value="CB File Hub" />
        <RegistryValue Root="HKLM" Key="Software\COOLBIRDZIK\CB File Hub\Capabilities" Name="ApplicationDescription" Type="string" Value="Torrent library and file manager" />
        <RegistryValue Root="HKLM" Key="Software\COOLBIRDZIK\CB File Hub\Capabilities\FileAssociations" Name=".torrent" Type="string" Value="CBFileHub.File.torrent" />
        <RegistryValue Root="HKLM" Key="Software\COOLBIRDZIK\CB File Hub\Capabilities\URLAssociations" Name="magnet" Type="string" Value="CBFileHub.Magnet" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="CB File Hub" Type="string" Value="Software\COOLBIRDZIK\CB File Hub\Capabilities" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu Shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="CB File Hub"
          Description="Launch CB File Hub" Target="[INSTALLFOLDER]cb_file_hub.exe"
          WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Name="installed"
          Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="ApplicationDesktopShortcut" Name="CB File Hub"
          Description="Launch CB File Hub" Target="[INSTALLFOLDER]cb_file_hub.exe"
          WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]"
          Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
