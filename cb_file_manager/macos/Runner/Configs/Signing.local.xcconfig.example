// Copy to Signing.local.xcconfig (git-ignored) to sign local builds with the
// release certificate "CB File Hub Signing" (see
// docs/technical/10-macos-code-signing.md). Dev builds then share the release
// app's identity: macOS keeps Full Disk Access across rebuilds, and one grant
// covers both the dev build and the installed app. Without this file builds
// are ad-hoc signed and lose permissions on every rebuild.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = CB File Hub Signing
DEVELOPMENT_TEAM =
